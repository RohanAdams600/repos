# These first two are stamped in automatically by your Autonoma account
# the moment you download this package — you shouldn't need to touch
# them. If you're running this file locally for development instead of
# a real download, pick any tier to test against.
SUBSCRIPTION_TIER=core
AGENT_KEY=

# Left blank on purpose — this agent runs on YOUR OWN Anthropic usage, not
# Autonoma's, so this key never passes through Autonoma's servers. Get one
# at https://console.anthropic.com if you don't have one, or just run
# `npm start` and fill it in through the setup wizard that opens instead.
ANTHROPIC_API_KEY=

# How often (in minutes) the agent checks data/inbound/*.json for new work.
HEARTBEAT_INTERVAL_MINUTES=15

# Local port for the one-time setup wizard (only used on first run).
WIZARD_PORT=4090
