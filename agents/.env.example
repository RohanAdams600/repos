# Anthropic API key used by every agent (manager + sub-agents)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the /backend service. Agents hold no direct database
# credentials at all — every state read/write (leads, agent_runs,
# heartbeats, guarantee SLA checks) goes through /backend's narrow
# /api/agents/* surface, authenticated with AGENTS_SERVICE_TOKEN below.
# This is what makes boundary #5 in identity.md ("no destructive DB ops
# for agents") absolute rather than a permissions setting to get wrong.
BACKEND_BASE_URL=http://localhost:4000
AGENTS_SERVICE_TOKEN=changeme-shared-secret-between-agents-and-backend

# Heartbeat cadence in minutes for the autonomous loop (Trust Stage 3+)
HEARTBEAT_INTERVAL_MINUTES=15

# Trust stage: manual | supervised | autonomous
# manual       - every sub-agent output is queued for founder review, nothing auto-sends
# supervised   - low-risk task types auto-execute, everything else queues for review
# autonomous   - heartbeat loop runs unattended; boundaries in identity.md are still hard-enforced in code
TRUST_STAGE=manual

# Where guarantee-SLA and boundary-violation alerts get sent
HEARTBEAT_ALERT_CHANNEL=founder@example.com

# Optional Slack webhook for real-time alerts (leave blank to log-only)
SLACK_ALERT_WEBHOOK_URL=
