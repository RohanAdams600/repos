{
  "name": "crossover-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D athlete viewer for NFL, MLB and NBA: console-style showroom, standouts discovery, same-league versus events, gear, grades and labelled data.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "standouts:report": "vitest run --config vitest.report.config.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
