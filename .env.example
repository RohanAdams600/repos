# Read by docker-compose.yml for variable substitution (docker compose
# auto-loads a .env file next to the compose file). Only needed if you're
# running the optional `agents` service via Docker Compose — copy this to
# `.env` and fill in a real key. Not needed to run backend + frontend for
# a landing-page demo; PAYMENTS_MODE=mock in docker-compose.yml means the
# whole waitlist -> checkout funnel works without this or Stripe.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
