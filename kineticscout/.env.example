# KineticScout environment. Copy to .env for local development; never commit real values.
# Staging and production refuse to boot unless every value marked [deployed] is set
# (see src/lib/env.ts). NEXT_PUBLIC_ variables are intentionally absent: nothing here reaches the browser.

# --- Core --------------------------------------------------------------------
NODE_ENV=development
# local | staging | production
DEPLOY_ENV=local
# web | worker (set to worker for the background worker process). The worker also needs SUPABASE_URL,
# SUPABASE_SECRET_KEY, STRIPE_SECRET_KEY, GCS and RESEND settings: it carries out account deletions
# (Stripe customer, stored videos, login) and sends the confirmation emails.
SERVICE_ROLE=web
# Public origin. Used for CSRF checks, redirects and email links. https required when deployed.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (Supabase Postgres) -----------------------------------------------
# Pooled connection (Supavisor transaction mode) used by the app at runtime.
DATABASE_URL=postgresql://kinetic:kinetic_dev_only@localhost:5432/kineticscout_dev
# Direct connection used only by `prisma migrate`.
DIRECT_DATABASE_URL=postgresql://kinetic:kinetic_dev_only@localhost:5432/kineticscout_dev
SHADOW_DATABASE_URL=postgresql://kinetic:kinetic_dev_only@localhost:5432/kineticscout_shadow
DATABASE_POOL_MAX=10

# --- Supabase Auth (server-side only) --------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# [deployed] Needed to delete auth users (age screen at onboarding, data deletion).
SUPABASE_SECRET_KEY=

# --- Redis -----------------------------------------------------------------------
# [deployed, web] Upstash REST for distributed rate limiting and caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# [deployed] TCP Redis for BullMQ queues. Must be rediss:// (TLS) when deployed.
REDIS_URL=redis://localhost:6379

# --- Stripe ------------------------------------------------------------------------
# [deployed, web] Restricted keys (rk_) are supported. Production requires live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Turn on after configuring Stripe Tax registrations.
STRIPE_AUTOMATIC_TAX=false
# Staging only: permit sk_test_ keys outside local development.
ALLOW_TEST_PAYMENTS=false

# --- AI ------------------------------------------------------------------------------
# [deployed]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Cost accounting at your contract prices (USD per million tokens).
OPENAI_INPUT_USD_PER_MTOK=0.4
OPENAI_OUTPUT_USD_PER_MTOK=1.6
# Hard monthly spending caps.
AI_GLOBAL_MONTHLY_BUDGET_USD=250
AI_USER_MONTHLY_BUDGET_USD=3
VIDEO_ANALYSIS_USD_PER_MINUTE=0.1
OBJECT_TRACKING_USD_PER_MINUTE=0.15
VIDEO_ANALYSES_PER_MONTH=30

# --- Google Cloud (video storage + Video Intelligence) ---------------------------------
# [deployed]
GCP_PROJECT_ID=
GCS_UPLOAD_BUCKET=
# Base64 service account JSON. Leave empty to use Application Default Credentials.
GCP_SERVICE_ACCOUNT_KEY_B64=

# --- Email -----------------------------------------------------------------------------
# [deployed, web]
RESEND_API_KEY=
EMAIL_FROM=KineticScout <no-reply@localhost>

# --- Secrets ---------------------------------------------------------------------------
# Generate each with: openssl rand -base64 48
HASH_PEPPER=
INTERNAL_API_SECRET=
# Self-hosting on several instances: share one Server Actions key (openssl rand -base64 32).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Business identity (shown on legal pages and emails) ----------------------------------
# [deployed, web] Real values only.
BUSINESS_LEGAL_NAME=
BUSINESS_POSTAL_ADDRESS=
BUSINESS_SUPPORT_EMAIL=
# E.164, optional, e.g. +15125550123
BUSINESS_PHONE=
# e.g. the State of Texas
BUSINESS_GOVERNING_LAW=

# --- Analytics (optional) ---------------------------------------------------------------
# GA4 measurement id. Leave empty to disable analytics and the consent banner entirely.
GA_MEASUREMENT_ID=

# --- Worker only -------------------------------------------------------------------------
# Agent 3: licensed program data feed (https JSON, see src/lib/recruiting/changes.ts). Leave empty to
# manage coaching changes and roster needs in /admin only.
PROGRAM_DATA_FEED_URL=
PROGRAM_DATA_FEED_TOKEN=
AGENT_TIMEZONE=America/New_York
WORKER_HEARTBEAT_URL=
GROWTH_TARGET_REGIONS=TX,FL,CA,GA,AZ,NC
GROWTH_AUTO_APPROVE=false
X_BEARER_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_AD_SET_ID=
META_GRAPH_VERSION=v23.0
META_AUTOPUBLISH=false
META_ADS_AUTO_ACTIVATE=false
META_MIN_REMAINING_CAP_USD=50
K_ANONYMITY_MIN=25
SEO_AUTOPUBLISH=false
VIDEO_RETENTION_DAYS=365

# --- Testing ---------------------------------------------------------------------------
# Test-only sign-in for the Playwright suite (src/lib/auth/e2e-stub.ts). The app refuses to boot
# with it outside DEPLOY_ENV=local. `npm run test:e2e` turns it on for its own server; leave it off here.
E2E_AUTH_STUB=false
