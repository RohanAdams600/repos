// KineticScout relational schema (PostgreSQL 15+).
//
// Conventions
// - Model names are singular PascalCase; tables and columns are snake_case via @@map/@map.
// - Primary keys are time-ordered UUIDv7 so inserts stay index-local.
// - users.id equals the Supabase Auth user id (auth.users.id). Prisma never writes to the auth schema.
// - Every user-owned row cascades on user deletion so a data deletion request removes everything.
// - Row Level Security is enabled on every table in the migration (deny-by-default for the
//   Supabase Data API). The application connects as the table owner through Prisma.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ATHLETE
  COACH
  /// High school or travel team coach (Phase 6). Records measurements for roster athletes.
  TEAM_COACH
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
}

enum Sport {
  BASEBALL
  HOCKEY
  FOOTBALL
}

/// Positions across supported sports. src/lib/athletes/positions.ts enforces that a
/// position belongs to the athlete's sport.
enum Position {
  // Baseball
  RHP
  LHP
  CATCHER
  FIRST_BASE     @map("1B")
  SECOND_BASE    @map("2B")
  THIRD_BASE     @map("3B")
  SHORTSTOP
  OUTFIELD
  UTILITY
  // Hockey
  CENTER
  WING
  DEFENSE
  GOALIE
  // Football
  QUARTERBACK
  RUNNING_BACK
  WIDE_RECEIVER
  TIGHT_END
  OFFENSIVE_LINE
  DEFENSIVE_LINE
  LINEBACKER
  DEFENSIVE_BACK
  SPECIALIST
}

/// Units and plausible ranges live in src/lib/metrics/definitions.ts.
enum MetricType {
  // Baseball
  EXIT_VELOCITY
  PITCH_VELO
  SIXTY_YARD_DASH   @map("60_YARD_DASH")
  POP_TIME
  INFIELD_VELO
  OUTFIELD_VELO
  BAT_SPEED
  // Hockey
  SLAPSHOT_SPEED
  WRIST_SHOT_SPEED
  // Football
  THROW_VELOCITY
  THROW_DISTANCE
  SPIRAL_EFFICIENCY
  FORTY_YARD_DASH   @map("40_YARD_DASH")
}

enum Division {
  D1
  D2
  D3
  NAIA
  JUCO
}

enum PipelineStatus {
  INTERESTED
  CONTACTED
  OFFERED
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum CheckoutSessionStatus {
  OPEN
  COMPLETE
  EXPIRED
}

enum GuardianConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

enum MotionType {
  SWING
  PITCH
  /// Hockey slapshot or wrist shot.
  HOCKEY_SHOT
  /// Football forward pass.
  FOOTBALL_THROW
}

enum Handedness {
  RIGHT
  LEFT
}

enum VideoAnalysisStatus {
  AWAITING_UPLOAD
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum ContentKind {
  DATA_REPORT
  CASE_STUDY
}

enum MarketingChannel {
  META_AD
  INSTAGRAM_POST
  FACEBOOK_POST
  X_POST
}

enum MarketingAssetStatus {
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
  FAILED
}

enum AgentType {
  GROWTH
  SEO
  RECRUITING
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum DeletionRequester {
  USER
  GUARDIAN
  ADMIN
}

enum AiFeature {
  GROWTH_AGENT
  SEO_AGENT
  OUTREACH_DRAFT
  VIDEO_ANALYSIS
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  /// Same value as auth.users.id in Supabase.
  id                      String           @id @db.Uuid
  email                   String           @unique @db.VarChar(254)
  role                    Role             @default(ATHLETE)
  stripeCustomerId        String?          @unique @map("stripe_customer_id") @db.VarChar(64)
  subscriptionTier        SubscriptionTier @default(FREE) @map("subscription_tier")
  /// Required to apply COPPA (under 13 is refused at sign-up) and minor protections (13 to 17).
  dateOfBirth             DateTime         @map("date_of_birth") @db.Date
  /// Marketing email is strictly opt-in. Transactional email does not depend on this flag.
  marketingEmailOptIn     Boolean          @default(false) @map("marketing_email_opt_in")
  /// When the marketing preference last changed (evidence of opt-in or opt-out).
  marketingOptInUpdatedAt DateTime?        @map("marketing_opt_in_updated_at")
  /// Self-serve or guardian deletion request. The worker deletes everything once this time passes.
  deletionScheduledFor    DateTime?        @map("deletion_scheduled_for")
  termsVersion            String           @map("terms_version") @db.VarChar(16)
  termsAcceptedAt         DateTime         @map("terms_accepted_at")
  /// First-touch UTM values, captured only with analytics consent. Shape: { utm_source, utm_medium, ... }.
  acquisition             Json?
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  athleteProfile    AthleteProfile?
  guardianConsent   GuardianConsent?
  subscriptions     Subscription[]
  checkoutSessions  CheckoutSession[]
  aiUsage           AiUsage[]
  testimonials      Testimonial[]
  notifications     Notification[]
  coachProfile      CoachProfile?
  coachReports      CoachReport[]
  teams             Team[]
  messagesSent      Message[]
  pushSubscriptions PushSubscription[]

  @@index([role])
  @@index([deletionScheduledFor])
  @@map("users")
}

model GuardianConsent {
  id                   String                @id @default(uuid(7)) @db.Uuid
  userId               String                @unique @map("user_id") @db.Uuid
  guardianEmail        String                @map("guardian_email") @db.VarChar(254)
  /// SHA-256 of the emailed token. The raw token is never stored.
  tokenHash            String                @unique @map("token_hash") @db.Char(64)
  status               GuardianConsentStatus @default(PENDING)
  expiresAt            DateTime              @map("expires_at")
  grantedAt            DateTime?             @map("granted_at")
  revokedAt            DateTime?             @map("revoked_at")
  /// SHA-256 of the guardian's long-lived management link token (withdraw consent, request deletion).
  manageTokenHash      String?               @unique @map("manage_token_hash") @db.Char(64)
  manageTokenExpiresAt DateTime?             @map("manage_token_expires_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("guardian_consents")
}

// ---------------------------------------------------------------------------
// Athletes and metrics
// ---------------------------------------------------------------------------

model AthleteProfile {
  userId                String      @id @map("user_id") @db.Uuid
  firstName             String      @map("first_name") @db.VarChar(50)
  lastName              String      @map("last_name") @db.VarChar(50)
  gradYear              Int         @map("grad_year") @db.SmallInt
  sport                 Sport       @default(BASEBALL)
  primaryPosition       Position    @map("primary_position")
  /// Inches.
  heightInches          Int?        @map("height") @db.SmallInt
  /// Pounds.
  weightLbs             Int?        @map("weight") @db.SmallInt
  gpa                   Decimal?    @db.Decimal(3, 2)
  highSchool            String?     @map("high_school") @db.VarChar(120)
  /// Stored without the leading @.
  twitterHandle         String?     @map("twitter_handle") @db.VarChar(15)
  bats                  Handedness?
  throws                Handedness?
  publicSlug            String?     @unique @map("public_slug") @db.VarChar(64)
  /// Profiles are private by default. Minors need guardian consent before going public.
  isPublic              Boolean     @default(false) @map("is_public")
  /// Optional fields shown on the public profile and PDF only when the athlete opts in.
  publicShowGpa         Boolean     @default(false) @map("public_show_gpa")
  publicShowSchool      Boolean     @default(false) @map("public_show_school")
  publicSince           DateTime?   @map("public_since")
  /// Agent 3: the athlete turned on coaching-change and roster-need alerts for their pipeline programs.
  recruitingAlerts      Boolean     @default(false) @map("recruiting_alerts")
  recruitingAlertEmails Boolean     @default(true) @map("recruiting_alert_emails")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics         Metric[]
  pipeline        RecruitingPipeline[]
  videoAnalyses   VideoAnalysis[]
  profileViews    ProfileViewDay[]
  outreachDrafts  OutreachDraft[]
  savedBy         SavedProspect[]
  contactRequests ContactRequest[]
  coachBlocks     CoachBlock[]
  teamMemberships TeamMember[]
  messageThreads  MessageThread[]
  teamEntries     TeamEntry[]

  @@index([sport, gradYear, primaryPosition])
  @@map("athlete_profiles")
}

model Metric {
  id         String       @id @default(uuid(7)) @db.Uuid
  athleteId  String       @map("athlete_id") @db.Uuid
  /// Date the measurement was taken (not the date it was logged).
  date       DateTime     @db.Date
  metricType MetricType   @map("metric_type")
  value      Decimal      @db.Decimal(7, 2)
  verified   Boolean      @default(false)
  /// Private storage object key of the supporting video. Resolved to a short-lived signed URL on read.
  videoUrl   String?      @map("video_url") @db.VarChar(512)
  /// SELF: logged by the athlete. TEAM: recorded by a verified team coach and accepted by the athlete.
  source     MetricSource @default(SELF)
  /// Team that recorded it; null for SELF, or once the team is deleted.
  teamId     String?      @map("team_id") @db.Uuid
  /// Attribution kept with the value even if the team is later deleted, e.g. "J. Lee, Westlake High School, testing on 2026-10-04".
  recordedBy String?      @map("recorded_by") @db.VarChar(200)
  /// Random id from the device that logged it; makes offline retries idempotent.
  clientRef  String?      @map("client_ref") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  athlete      AthleteProfile      @relation(fields: [athleteId], references: [userId], onDelete: Cascade)
  verification MetricVerification?
  team         Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamEntry    TeamEntry?

  @@unique([athleteId, clientRef])
  // Profile pages and progression charts: latest values per type.
  @@index([athleteId, metricType, date(sort: Desc)])
  // Free tier monthly logging quota.
  @@index([athleteId, createdAt])
  // Weekly percentile aggregation.
  @@index([metricType, date])
  @@map("metrics")
}

// ---------------------------------------------------------------------------
// Colleges and recruiting
// ---------------------------------------------------------------------------

model CollegeProgram {
  id                       String    @id @default(uuid(7)) @db.Uuid
  schoolName               String    @map("school_name") @db.VarChar(160)
  sport                    Sport     @default(BASEBALL)
  division                 Division
  conference               String?   @db.VarChar(120)
  /// Two-letter US state or territory code.
  state                    String?   @db.Char(2)
  /// Shape validated by src/lib/matchmaker/program-metrics.ts:
  /// { "<MetricType>": { "mean": number, "sd": number } }
  averageRecruitingMetrics Json      @map("average_recruiting_metrics")
  minGpa                   Decimal?  @map("min_gpa") @db.Decimal(3, 2)
  headCoachName            String?   @map("head_coach_name") @db.VarChar(120)
  headCoachEmail           String?   @map("head_coach_email") @db.VarChar(254)
  headCoachSince           DateTime? @map("head_coach_since") @db.Date
  /// Publicly documented career facts about the head coach (previous jobs, playing career, stated
  /// philosophy), with sources. The only coach information outreach drafts may use.
  headCoachBackground      String?   @map("head_coach_background") @db.VarChar(1500)
  /// Short factual summary of recent results, e.g. "2026: 38-21, won the conference tournament".
  recentSeasonSummary      String?   @map("recent_season_summary") @db.VarChar(600)
  /// Where the program data came from, so every number shown to users is traceable.
  dataSourceUrl            String?   @map("data_source_url") @db.VarChar(512)
  dataVerifiedAt           DateTime? @map("data_verified_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  pipeline       RecruitingPipeline[]
  changes        ProgramChange[]
  rosterNeeds    RosterNeed[]
  outreachDrafts OutreachDraft[]
  coaches        CoachProfile[]

  @@unique([schoolName, sport])
  @@index([sport, division])
  @@map("college_programs")
}

model RecruitingPipeline {
  id              String         @id @default(uuid(7)) @db.Uuid
  athleteId       String         @map("athlete_id") @db.Uuid
  collegeId       String         @map("college_id") @db.Uuid
  status          PipelineStatus @default(INTERESTED)
  lastContactDate DateTime?      @map("last_contact_date") @db.Date
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)
  college CollegeProgram @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([athleteId, collegeId])
  @@index([athleteId, status])
  @@index([collegeId])
  @@map("recruiting_pipeline")
}

// ---------------------------------------------------------------------------
// Billing (Stripe is the source of truth; these tables are a synchronized mirror)
// ---------------------------------------------------------------------------

model Subscription {
  /// Stripe subscription id (sub_...).
  id                String             @id @db.VarChar(64)
  userId            String             @map("user_id") @db.Uuid
  status            SubscriptionStatus
  priceId           String             @map("price_id") @db.VarChar(64)
  interval          BillingInterval
  currentPeriodEnd  DateTime?          @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A partial unique index in the migration guarantees at most one live subscription per user.
  @@index([userId, status])
  @@map("subscriptions")
}

model CheckoutSession {
  /// Stripe Checkout Session id (cs_...).
  id        String                @id @db.VarChar(255)
  userId    String                @map("user_id") @db.Uuid
  priceId   String                @map("price_id") @db.VarChar(64)
  url       String                @db.VarChar(2048)
  status    CheckoutSessionStatus @default(OPEN)
  expiresAt DateTime              @map("expires_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@map("checkout_sessions")
}

/// Webhook idempotency ledger. A Stripe event id is processed at most once.
model StripeEvent {
  id          String   @id @db.VarChar(255)
  type        String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("stripe_events")
}

// ---------------------------------------------------------------------------
// AI biomechanics
// ---------------------------------------------------------------------------

model VideoAnalysis {
  id          String              @id @default(uuid(7)) @db.Uuid
  athleteId   String              @map("athlete_id") @db.Uuid
  motionType  MotionType          @map("motion_type")
  handedness  Handedness
  status      VideoAnalysisStatus @default(AWAITING_UPLOAD)
  /// Private object key in the uploads bucket.
  objectKey   String              @unique @map("object_key") @db.VarChar(512)
  contentType String              @map("content_type") @db.VarChar(64)
  sizeBytes   Int                 @map("size_bytes")
  durationMs  Int?                @map("duration_ms")
  /// Pixel dimensions reported at upload, used to compute true-proportion distances from normalized keypoints.
  widthPx     Int?                @map("width_px")
  heightPx    Int?                @map("height_px")
  /// Compact pose track used by the skeleton overlay. Loaded only on the detail view.
  poseData    Json?               @map("pose_data")
  /// Kinematic sequence report (see src/lib/biomechanics/types.ts).
  report      Json?
  /// Puck or ball tracking requested (beta, extra Video Intelligence cost).
  trackObject Boolean             @default(false) @map("track_object")
  /// Projectile estimate (see src/lib/biomechanics/projectile.ts).
  projectile  Json?
  algorithm   String?             @db.VarChar(32)
  errorCode   String?             @map("error_code") @db.VarChar(64)
  createdAt   DateTime            @default(now()) @map("created_at")
  startedAt   DateTime?           @map("started_at")
  completedAt DateTime?           @map("completed_at")

  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)

  @@index([athleteId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("video_analyses")
}

// ---------------------------------------------------------------------------
// Autonomous agents
// ---------------------------------------------------------------------------

/// Weekly percentile baselines computed by the Data and SEO agent from anonymized aggregates.
/// Cohorts below the k-anonymity threshold are never stored.
model PercentileBaseline {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Monday of the ISO week the snapshot covers.
  computedFor DateTime   @map("computed_for") @db.Date
  /// "<METRIC>|<GRAD_YEAR or *>|<POSITION or *>". Keeps the unique key NULL-free.
  cohortKey   String     @map("cohort_key") @db.VarChar(64)
  metricType  MetricType @map("metric_type")
  gradYear    Int?       @map("grad_year") @db.SmallInt
  position    Position?
  sampleSize  Int        @map("sample_size")
  p10         Decimal    @db.Decimal(7, 2)
  p25         Decimal    @db.Decimal(7, 2)
  p50         Decimal    @db.Decimal(7, 2)
  p75         Decimal    @db.Decimal(7, 2)
  p90         Decimal    @db.Decimal(7, 2)
  mean        Decimal    @db.Decimal(7, 2)
  stddev      Decimal    @db.Decimal(7, 2)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@unique([computedFor, cohortKey])
  @@index([metricType, gradYear, position, computedFor(sort: Desc)])
  @@map("percentile_baselines")
}

model BlogPost {
  id                String        @id @default(uuid(7)) @db.Uuid
  slug              String        @unique @db.VarChar(120)
  title             String        @db.VarChar(120)
  metaDescription   String        @map("meta_description") @db.VarChar(160)
  /// Markdown. Rendered without raw HTML support, so it cannot carry script.
  bodyMarkdown      String        @map("body_markdown") @db.Text
  status            ContentStatus @default(DRAFT)
  /// The exact aggregate numbers the post was written from.
  dataSnapshot      Json          @map("data_snapshot")
  validationReport  Json?         @map("validation_report")
  /// Model identifier when AI-assisted. Shown to readers as a disclosure.
  generatedBy       String?       @map("generated_by") @db.VarChar(64)
  kind              ContentKind   @default(DATA_REPORT)
  /// Case studies only: when the featured athlete (and guardian, for minors) gave written consent to publish.
  consentRecordedAt DateTime?     @map("consent_recorded_at")
  agentRunId        String?       @map("agent_run_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)])
  @@index([kind, status, publishedAt(sort: Desc)])
  @@map("blog_posts")
}

model MarketingAsset {
  id               String               @id @default(uuid(7)) @db.Uuid
  agentRunId       String               @map("agent_run_id") @db.Uuid
  channel          MarketingChannel
  status           MarketingAssetStatus @default(DRAFT)
  topic            String               @db.VarChar(200)
  /// Ready-to-publish payload for the channel.
  payload          Json
  /// Findings from the claims and policy checker. Empty array means clean.
  complianceIssues Json                 @map("compliance_issues")
  externalId       String?              @map("external_id") @db.VarChar(128)
  publishedAt      DateTime?            @map("published_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([agentRunId])
  @@map("marketing_assets")
}

model AgentRun {
  id         String         @id @default(uuid(7)) @db.Uuid
  agent      AgentType
  /// Schedule slot, e.g. "2026-10-06T10:00". Unique per agent so overlapping schedulers cannot double-run.
  slot       String         @db.VarChar(32)
  status     AgentRunStatus @default(RUNNING)
  stats      Json?
  error      String?        @db.Text
  startedAt  DateTime       @default(now()) @map("started_at")
  finishedAt DateTime?      @map("finished_at")

  marketingAssets MarketingAsset[]
  blogPosts       BlogPost[]

  @@unique([agent, slot])
  @@index([agent, startedAt(sort: Desc)])
  @@map("agent_runs")
}

/// Cost ledger for every paid AI call. Enforces per-user and global monthly spending caps.
model AiUsage {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  feature      AiFeature
  model        String    @db.VarChar(64)
  inputTokens  Int       @default(0) @map("input_tokens")
  outputTokens Int       @default(0) @map("output_tokens")
  /// Estimated cost in millionths of a US dollar.
  costMicros   Int       @map("cost_micros")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

/// Security-relevant events. Holds ids, never secrets or raw IP addresses.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(64)
  targetId   String?  @map("target_id") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Marketing site
// ---------------------------------------------------------------------------

/// Reviews from real users only. Published only with recorded consent; admins cannot invent an author.
model Testimonial {
  id                String        @id @default(uuid(7)) @db.Uuid
  /// The KineticScout account that gave the review. Deleting the account deletes the review.
  userId            String        @map("user_id") @db.Uuid
  displayName       String        @map("display_name") @db.VarChar(80)
  /// e.g. "Parent of a 2027 shortstop", written or approved by the author.
  descriptor        String        @db.VarChar(120)
  quote             String        @db.VarChar(600)
  rating            Int?          @db.SmallInt
  status            ContentStatus @default(DRAFT)
  consentRecordedAt DateTime      @map("consent_recorded_at")
  publishedAt       DateTime?     @map("published_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt(sort: Desc)])
  @@map("testimonials")
}

/// Contact form submissions. Purged after 12 months by the worker sweep.
model ContactMessage {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(100)
  email     String    @db.VarChar(254)
  topic     String    @db.VarChar(32)
  message   String    @db.VarChar(4000)
  repliedAt DateTime? @map("replied_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

/// Proof that a deletion request was received and completed. Holds no personal data: the subject is
/// a keyed hash of the deleted user id, so a later inquiry can be answered without keeping the account.
model DataDeletionReceipt {
  id           String            @id @default(uuid(7)) @db.Uuid
  subjectHash  String            @map("subject_hash") @db.Char(64)
  requestedBy  DeletionRequester @map("requested_by")
  requestedAt  DateTime          @map("requested_at")
  scheduledFor DateTime          @map("scheduled_for")
  canceledAt   DateTime?         @map("canceled_at")
  completedAt  DateTime?         @map("completed_at")
  /// Steps finished so far (stripe, storage, auth, database). Makes retries resume, not repeat.
  steps        Json              @default("[]")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([subjectHash])
  @@index([completedAt, scheduledFor])
  @@map("data_deletion_receipts")
}

// ---------------------------------------------------------------------------
// Phase 4: public profiles, verification, Agent 3, comparisons
// ---------------------------------------------------------------------------

/// Daily public profile counters. No visitor identifiers are stored.
model ProfileViewDay {
  athleteId    String   @map("athlete_id") @db.Uuid
  day          DateTime @db.Date
  views        Int      @default(0)
  pdfDownloads Int      @default(0) @map("pdf_downloads")

  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)

  @@id([athleteId, day])
  @@map("profile_view_days")
}

enum VerificationStatus {
  AWAITING_UPLOAD
  CHECKING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum VerificationRejection {
  UNREADABLE_FILE
  DUPLICATE_VIDEO
  TOO_LONG
  VALUE_NOT_VISIBLE
  VALUE_MISMATCH
  WRONG_EVENT
  OTHER
}

/// Evidence for one metric: a clip showing the measurement (radar display, timing system, launch
/// monitor). Automated checks run first; a staff reviewer then confirms the value before
/// Metric.verified becomes true.
model MetricVerification {
  metricId        String                 @id @map("metric_id") @db.Uuid
  athleteId       String                 @map("athlete_id") @db.Uuid
  status          VerificationStatus     @default(AWAITING_UPLOAD)
  /// Private object key; deleted 30 days after the review decision.
  objectKey       String?                @unique @map("object_key") @db.VarChar(512)
  contentType     String                 @map("content_type") @db.VarChar(64)
  sizeBytes       Int                    @map("size_bytes")
  /// SHA-256 of the file. Kept after the video is deleted so a clip cannot be reused for another metric.
  sha256          String?                @db.Char(64)
  durationMs      Int?                   @map("duration_ms")
  /// Recording time from the container metadata, when the camera wrote one.
  recordedAt      DateTime?              @map("recorded_at")
  checks          Json?
  rejectionReason VerificationRejection? @map("rejection_reason")
  reviewerNote    String?                @map("reviewer_note") @db.VarChar(500)
  reviewedById    String?                @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?              @map("reviewed_at")
  videoDeletedAt  DateTime?              @map("video_deleted_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  metric Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sha256])
  @@index([athleteId, createdAt])
  @@map("metric_verifications")
}

enum NotificationKind {
  COACH_CHANGE
  ROSTER_NEED
  METRIC_VERIFIED
  METRIC_REJECTED
  CONTACT_REQUEST
  CONTACT_UPDATE
  COACH_VERIFICATION
  TEAM_UPDATE
  MESSAGE
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  kind      NotificationKind
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(1000)
  /// Relative in-app link.
  href      String?          @db.VarChar(512)
  /// Makes fan-out idempotent, e.g. "change:<id>".
  dedupeKey String?          @map("dedupe_key") @db.VarChar(128)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum ProgramChangeKind {
  HEAD_COACH_CHANGED
  ROSTER_NEED_POSTED
}

/// Change events detected in program data (staff edits or the licensed data feed). Agent 3 fans
/// each event out to athletes watching the program.
model ProgramChange {
  id            String            @id @default(uuid(7)) @db.Uuid
  collegeId     String            @map("college_id") @db.Uuid
  kind          ProgramChangeKind
  previousValue Json?             @map("previous_value")
  newValue      Json              @map("new_value")
  sourceUrl     String?           @map("source_url") @db.VarChar(512)
  detectedAt    DateTime          @default(now()) @map("detected_at")
  processedAt   DateTime?         @map("processed_at")

  college CollegeProgram  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  drafts  OutreachDraft[]

  @@index([processedAt, detectedAt])
  @@index([collegeId, detectedAt(sort: Desc)])
  @@map("program_changes")
}

model RosterNeed {
  id        String    @id @default(uuid(7)) @db.Uuid
  collegeId String    @map("college_id") @db.Uuid
  position  Position?
  gradYear  Int?      @map("grad_year") @db.SmallInt
  note      String    @db.VarChar(300)
  sourceUrl String    @map("source_url") @db.VarChar(512)
  postedAt  DateTime  @map("posted_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  college CollegeProgram @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId, postedAt(sort: Desc)])
  @@map("roster_needs")
}

enum OutreachTrigger {
  MANUAL
  COACH_CHANGE
  ROSTER_NEED
}

enum OutreachChannel {
  EMAIL
  DM
}

/// AI-drafted message for the athlete to review, edit and send themselves. KineticScout never sends it.
model OutreachDraft {
  id        String          @id @default(uuid(7)) @db.Uuid
  athleteId String          @map("athlete_id") @db.Uuid
  collegeId String          @map("college_id") @db.Uuid
  changeId  String?         @map("change_id") @db.Uuid
  trigger   OutreachTrigger
  channel   OutreachChannel
  subject   String?         @db.VarChar(160)
  body      String          @db.VarChar(4000)
  /// Snapshot of the facts the draft was allowed to use.
  facts     Json
  model     String          @db.VarChar(64)
  copiedAt  DateTime?       @map("copied_at")
  createdAt DateTime        @default(now()) @map("created_at")

  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)
  college CollegeProgram @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  change  ProgramChange? @relation(fields: [changeId], references: [id], onDelete: SetNull)

  @@unique([athleteId, changeId])
  @@index([athleteId, createdAt(sort: Desc)])
  @@map("outreach_drafts")
}

enum ReferenceClipStatus {
  AWAITING_UPLOAD
  PROCESSING
  READY
  FAILED
}

/// Licensed reference footage for side-by-side comparisons. Playable only while the licence is valid.
model ReferenceClip {
  id               String              @id @default(uuid(7)) @db.Uuid
  title            String              @db.VarChar(120)
  playerName       String              @map("player_name") @db.VarChar(120)
  /// e.g. "MLB", "NCAA D1".
  level            String              @db.VarChar(40)
  motionType       MotionType          @map("motion_type")
  handedness       Handedness
  status           ReferenceClipStatus @default(AWAITING_UPLOAD)
  objectKey        String              @unique @map("object_key") @db.VarChar(512)
  contentType      String              @map("content_type") @db.VarChar(64)
  sizeBytes        Int                 @map("size_bytes")
  durationMs       Int?                @map("duration_ms")
  widthPx          Int?                @map("width_px")
  heightPx         Int?                @map("height_px")
  poseData         Json?               @map("pose_data")
  report           Json?
  errorCode        String?             @map("error_code") @db.VarChar(64)
  licensor         String              @db.VarChar(160)
  licenseReference String              @map("license_reference") @db.VarChar(160)
  licenseExpiresAt DateTime?           @map("license_expires_at")
  attribution      String              @db.VarChar(300)
  active           Boolean             @default(false)
  createdById      String?             @map("created_by_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([motionType, handedness, active, status])
  @@map("reference_clips")
}

// ---------------------------------------------------------------------------
// Phase 5: coach tools
// ---------------------------------------------------------------------------

enum CoachVerificationStatus {
  UNSUBMITTED
  EMAIL_PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

/// A college coach. Search, saved prospects and contact requests require status VERIFIED: the coach
/// proved control of a school email address and a staff member matched them to the program's
/// published staff directory.
model CoachProfile {
  userId                  String                  @id @map("user_id") @db.Uuid
  firstName               String                  @map("first_name") @db.VarChar(50)
  lastName                String                  @map("last_name") @db.VarChar(50)
  title                   String                  @db.VarChar(80)
  collegeId               String?                 @map("college_id") @db.Uuid
  workEmail               String?                 @map("work_email") @db.VarChar(254)
  workEmailTokenHash      String?                 @unique @map("work_email_token_hash") @db.Char(64)
  workEmailTokenExpiresAt DateTime?               @map("work_email_token_expires_at")
  workEmailVerifiedAt     DateTime?               @map("work_email_verified_at")
  /// Public staff directory page listing the coach, checked by the reviewer.
  staffDirectoryUrl       String?                 @map("staff_directory_url") @db.VarChar(512)
  status                  CoachVerificationStatus @default(UNSUBMITTED)
  reviewNote              String?                 @map("review_note") @db.VarChar(500)
  reviewedById            String?                 @map("reviewed_by_id") @db.Uuid
  reviewedAt              DateTime?               @map("reviewed_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  college         CollegeProgram?  @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  savedProspects  SavedProspect[]
  contactRequests ContactRequest[]
  blockedBy       CoachBlock[]
  reports         CoachReport[]
  messageThreads  MessageThread[]

  @@index([status, updatedAt])
  @@index([collegeId])
  @@map("coach_profiles")
}

/// A coach's private board. Notes are visible only to the coach who wrote them.
model SavedProspect {
  coachId   String   @map("coach_id") @db.Uuid
  athleteId String   @map("athlete_id") @db.Uuid
  note      String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coach   CoachProfile   @relation(fields: [coachId], references: [userId], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)

  @@id([coachId, athleteId])
  @@index([athleteId])
  @@map("saved_prospects")
}

enum ContactRequestStatus {
  PENDING
  /// The athlete accepted; a parent or guardian must approve before details are shared.
  ATHLETE_ACCEPTED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

/// A coach asking to contact an athlete. Contact details are shared only once the athlete (and,
/// for an athlete under 18, a parent or guardian) accepts.
model ContactRequest {
  id                     String               @id @default(uuid(7)) @db.Uuid
  coachId                String               @map("coach_id") @db.Uuid
  athleteId              String               @map("athlete_id") @db.Uuid
  message                String               @db.VarChar(1000)
  status                 ContactRequestStatus @default(PENDING)
  guardianRequired       Boolean              @map("guardian_required")
  guardianTokenHash      String?              @unique @map("guardian_token_hash") @db.Char(64)
  guardianTokenExpiresAt DateTime?            @map("guardian_token_expires_at")
  athleteRespondedAt     DateTime?            @map("athlete_responded_at")
  guardianRespondedAt    DateTime?            @map("guardian_responded_at")
  /// Addresses shared with the coach on acceptance (the athlete's, plus the guardian's for minors).
  sharedEmails           String[]             @default([]) @map("shared_emails")
  createdAt              DateTime             @default(now()) @map("created_at")
  expiresAt              DateTime             @map("expires_at")

  coach   CoachProfile   @relation(fields: [coachId], references: [userId], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)
  thread  MessageThread?

  @@index([athleteId, status, createdAt(sort: Desc)])
  @@index([coachId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("contact_requests")
}

/// An athlete who blocked a coach: no search results, saves or requests between them.
model CoachBlock {
  athleteId String   @map("athlete_id") @db.Uuid
  coachId   String   @map("coach_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)
  coach   CoachProfile   @relation(fields: [coachId], references: [userId], onDelete: Cascade)

  @@id([athleteId, coachId])
  @@map("coach_blocks")
}

model CoachReport {
  id         String    @id @default(uuid(7)) @db.Uuid
  coachId    String    @map("coach_id") @db.Uuid
  reporterId String    @map("reporter_id") @db.Uuid
  reason     String    @db.VarChar(1000)
  resolvedAt DateTime? @map("resolved_at")
  resolution String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")

  coach    CoachProfile @relation(fields: [coachId], references: [userId], onDelete: Cascade)
  reporter User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
  @@map("coach_reports")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: national norms
// ---------------------------------------------------------------------------------------------

enum NormDatasetStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// A licensed table of published percentile values. Rows never change after import; a new edition
/// is a new dataset. Only ACTIVE datasets with an unexpired licence are used for percentiles.
model NormDataset {
  id               String            @id @default(uuid(7)) @db.Uuid
  name             String            @db.VarChar(160)
  publisher        String            @db.VarChar(160)
  edition          String            @db.VarChar(40)
  /// Who was measured, as the publisher describes it (shown next to every result).
  population       String            @db.VarChar(400)
  sourceUrl        String            @map("source_url") @db.VarChar(512)
  /// Licence terms that allow showing these figures to users.
  licence          String            @db.VarChar(1000)
  licenceExpiresAt DateTime?         @map("licence_expires_at") @db.Date
  status           NormDatasetStatus @default(DRAFT)
  rowCount         Int               @map("row_count")
  importedById     String?           @map("imported_by_id") @db.Uuid
  activatedAt      DateTime?         @map("activated_at")
  retiredAt        DateTime?         @map("retired_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  rows NormRow[]

  @@unique([publisher, name, edition])
  @@index([status, activatedAt])
  @@map("norm_datasets")
}

/// One band of a norm table: raw-value quantiles (p10 is the value 10% of the population measured
/// below; for timed events that is the fast end). A null min and max means the band covers all
/// values of that dimension.
model NormRow {
  id         String     @id @default(uuid(7)) @db.Uuid
  datasetId  String     @map("dataset_id") @db.Uuid
  metricType MetricType @map("metric_type")
  ageMin     Int?       @map("age_min") @db.SmallInt
  ageMax     Int?       @map("age_max") @db.SmallInt
  heightMin  Int?       @map("height_min") @db.SmallInt
  heightMax  Int?       @map("height_max") @db.SmallInt
  weightMin  Int?       @map("weight_min") @db.SmallInt
  weightMax  Int?       @map("weight_max") @db.SmallInt
  sampleSize Int        @map("sample_size")
  p10        Decimal    @db.Decimal(8, 3)
  p25        Decimal    @db.Decimal(8, 3)
  p50        Decimal    @db.Decimal(8, 3)
  p75        Decimal    @db.Decimal(8, 3)
  p90        Decimal    @db.Decimal(8, 3)

  dataset NormDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, metricType])
  @@map("norm_rows")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: team accounts
// ---------------------------------------------------------------------------------------------

enum MetricSource {
  SELF
  TEAM
}

enum TeamStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum TeamOrgType {
  HIGH_SCHOOL
  CLUB
}

/// A high school or travel team run by one TEAM_COACH account. Staff check the coach against the
/// school's or club's public staff page before athletes can join.
model Team {
  id           String      @id @default(uuid(7)) @db.Uuid
  coachId      String      @map("coach_id") @db.Uuid
  name         String      @db.VarChar(120)
  sport        Sport
  orgType      TeamOrgType @map("org_type")
  organization String      @db.VarChar(160)
  state        String      @db.Char(2)
  coachName    String      @map("coach_name") @db.VarChar(120)
  coachTitle   String      @map("coach_title") @db.VarChar(80)
  /// Public page that lists this coach (school athletics staff page or club staff page).
  directoryUrl String      @map("directory_url") @db.VarChar(512)
  status       TeamStatus  @default(PENDING)
  reviewNote   String?     @map("review_note") @db.VarChar(500)
  reviewedById String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?   @map("reviewed_at")
  /// Code the coach shares with players. Joining still needs the coach's approval (and a guardian's for minors).
  joinCode     String      @unique @map("join_code") @db.VarChar(12)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  coach    User             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  members  TeamMember[]
  sessions TestingSession[]
  entries  TeamEntry[]
  metrics  Metric[]

  @@index([coachId])
  @@index([status, updatedAt])
  @@map("teams")
}

enum TeamMemberStatus {
  /// The athlete asked to join with the team code; waiting for the coach.
  REQUESTED
  /// The coach approved; a parent or guardian must approve for an athlete under 18.
  AWAITING_GUARDIAN
  ACTIVE
  DECLINED
  LEFT
  REMOVED
}

model TeamMember {
  id                     String           @id @default(uuid(7)) @db.Uuid
  teamId                 String           @map("team_id") @db.Uuid
  athleteId              String           @map("athlete_id") @db.Uuid
  status                 TeamMemberStatus @default(REQUESTED)
  guardianRequired       Boolean          @map("guardian_required")
  guardianTokenHash      String?          @unique @map("guardian_token_hash") @db.Char(64)
  guardianTokenExpiresAt DateTime?        @map("guardian_token_expires_at")
  requestedAt            DateTime         @default(now()) @map("requested_at")
  coachDecidedAt         DateTime?        @map("coach_decided_at")
  guardianRespondedAt    DateTime?        @map("guardian_responded_at")
  endedAt                DateTime?        @map("ended_at")

  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)

  @@index([teamId, status])
  @@index([athleteId, status])
  @@map("team_members")
}

/// A testing day: the coach records measurements for several athletes at once.
model TestingSession {
  id        String   @id @default(uuid(7)) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  date      DateTime @db.Date
  label     String   @db.VarChar(120)
  location  String?  @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")

  team    Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  entries TeamEntry[]

  @@index([teamId, date(sort: Desc)])
  @@map("testing_sessions")
}

enum TeamEntryStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// A value the coach recorded. It becomes a Metric only when the athlete accepts it.
model TeamEntry {
  id          String          @id @default(uuid(7)) @db.Uuid
  sessionId   String          @map("session_id") @db.Uuid
  teamId      String          @map("team_id") @db.Uuid
  athleteId   String          @map("athlete_id") @db.Uuid
  metricType  MetricType      @map("metric_type")
  value       Decimal         @db.Decimal(7, 2)
  status      TeamEntryStatus @default(PENDING)
  metricId    String?         @unique @map("metric_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  respondedAt DateTime?       @map("responded_at")

  session TestingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)
  metric  Metric?        @relation(fields: [metricId], references: [id], onDelete: SetNull)

  @@unique([sessionId, athleteId, metricType])
  @@index([athleteId, status])
  @@map("team_entries")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: in-app messaging
// ---------------------------------------------------------------------------------------------

enum MessageThreadStatus {
  OPEN
  CLOSED
}

enum MessageReporter {
  ATHLETE
  COACH
  GUARDIAN
}

/// One conversation per accepted contact request. For athletes under 18 the parent or guardian is
/// emailed a copy of every message and can read the thread or end it through a signed link.
model MessageThread {
  id               String              @id @default(uuid(7)) @db.Uuid
  contactRequestId String              @unique @map("contact_request_id") @db.Uuid
  coachId          String              @map("coach_id") @db.Uuid
  athleteId        String              @map("athlete_id") @db.Uuid
  guardianCopy     Boolean             @map("guardian_copy")
  status           MessageThreadStatus @default(OPEN)
  /// athlete, coach, guardian, block, consent, suspended or staff.
  closedBy         String?             @map("closed_by") @db.VarChar(20)
  closedAt         DateTime?           @map("closed_at")
  lastMessageAt    DateTime            @default(now()) @map("last_message_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  coach          CoachProfile   @relation(fields: [coachId], references: [userId], onDelete: Cascade)
  athlete        AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)
  messages       Message[]

  @@index([coachId, lastMessageAt(sort: Desc)])
  @@index([athleteId, lastMessageAt(sort: Desc)])
  @@index([status, closedAt])
  @@map("message_threads")
}

/// Plain text, shown without automatic links.
model Message {
  id        String    @id @default(uuid(7)) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  body      String    @db.VarChar(2000)
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  thread  MessageThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender  User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports MessageReport[]

  @@index([threadId, createdAt])
  @@map("messages")
}

model MessageReport {
  id           String          @id @default(uuid(7)) @db.Uuid
  messageId    String          @map("message_id") @db.Uuid
  reporterKind MessageReporter @map("reporter_kind")
  /// Null when a parent or guardian reported through their link (they have no account).
  reporterId   String?         @map("reporter_id") @db.Uuid
  reason       String          @db.VarChar(1000)
  resolvedAt   DateTime?       @map("resolved_at")
  resolution   String?         @db.VarChar(500)
  createdAt    DateTime        @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
  @@map("message_reports")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: installable app
// ---------------------------------------------------------------------------------------------

/// A browser push subscription, created only when the user turns on notifications for a device.
/// The endpoint is a capability URL at the browser vendor's push service.
model PushSubscription {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique @db.VarChar(1024)
  p256dh        String    @db.VarChar(128)
  auth          String    @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSuccessAt DateTime? @map("last_success_at")
  failureCount  Int       @default(0) @map("failure_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
