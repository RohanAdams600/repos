// KineticScout relational schema (PostgreSQL 15+).
//
// Conventions
// - Model names are singular PascalCase; tables and columns are snake_case via @@map/@map.
// - Primary keys are time-ordered UUIDv7 so inserts stay index-local.
// - users.id equals the Supabase Auth user id (auth.users.id). Prisma never writes to the auth schema.
// - Every user-owned row cascades on user deletion so a data deletion request removes everything.
// - Row Level Security is enabled on every table in the migration (deny-by-default for the
//   Supabase Data API). The application connects as the table owner through Prisma.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ATHLETE
  COACH
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
}

enum Sport {
  BASEBALL
  HOCKEY
  FOOTBALL
}

/// Positions across supported sports. src/lib/athletes/positions.ts enforces that a
/// position belongs to the athlete's sport.
enum Position {
  // Baseball
  RHP
  LHP
  CATCHER
  FIRST_BASE   @map("1B")
  SECOND_BASE  @map("2B")
  THIRD_BASE   @map("3B")
  SHORTSTOP
  OUTFIELD
  UTILITY
  // Hockey
  CENTER
  WING
  DEFENSE
  GOALIE
  // Football
  QUARTERBACK
  RUNNING_BACK
  WIDE_RECEIVER
  TIGHT_END
  OFFENSIVE_LINE
  DEFENSIVE_LINE
  LINEBACKER
  DEFENSIVE_BACK
  SPECIALIST
}

/// Units and plausible ranges live in src/lib/metrics/definitions.ts.
enum MetricType {
  // Baseball
  EXIT_VELOCITY
  PITCH_VELO
  SIXTY_YARD_DASH   @map("60_YARD_DASH")
  POP_TIME
  INFIELD_VELO
  OUTFIELD_VELO
  BAT_SPEED
  // Hockey
  SLAPSHOT_SPEED
  WRIST_SHOT_SPEED
  // Football
  THROW_VELOCITY
  THROW_DISTANCE
  SPIRAL_EFFICIENCY
  FORTY_YARD_DASH   @map("40_YARD_DASH")
}

enum Division {
  D1
  D2
  D3
  NAIA
  JUCO
}

enum PipelineStatus {
  INTERESTED
  CONTACTED
  OFFERED
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum CheckoutSessionStatus {
  OPEN
  COMPLETE
  EXPIRED
}

enum GuardianConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

enum MotionType {
  SWING
  PITCH
}

enum Handedness {
  RIGHT
  LEFT
}

enum VideoAnalysisStatus {
  AWAITING_UPLOAD
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum ContentKind {
  DATA_REPORT
  CASE_STUDY
}

enum MarketingChannel {
  META_AD
  INSTAGRAM_POST
  FACEBOOK_POST
  X_POST
}

enum MarketingAssetStatus {
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
  FAILED
}

enum AgentType {
  GROWTH
  SEO
  RECRUITING
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum DeletionRequester {
  USER
  GUARDIAN
  ADMIN
}

enum AiFeature {
  GROWTH_AGENT
  SEO_AGENT
  OUTREACH_DRAFT
  VIDEO_ANALYSIS
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  /// Same value as auth.users.id in Supabase.
  id                  String           @id @db.Uuid
  email               String           @unique @db.VarChar(254)
  role                Role             @default(ATHLETE)
  stripeCustomerId    String?          @unique @map("stripe_customer_id") @db.VarChar(64)
  subscriptionTier    SubscriptionTier @default(FREE) @map("subscription_tier")
  /// Required to apply COPPA (under 13 is refused at sign-up) and minor protections (13 to 17).
  dateOfBirth         DateTime         @map("date_of_birth") @db.Date
  /// Marketing email is strictly opt-in. Transactional email does not depend on this flag.
  marketingEmailOptIn Boolean          @default(false) @map("marketing_email_opt_in")
  /// When the marketing preference last changed (evidence of opt-in or opt-out).
  marketingOptInUpdatedAt DateTime?    @map("marketing_opt_in_updated_at")
  /// Self-serve or guardian deletion request. The worker deletes everything once this time passes.
  deletionScheduledFor DateTime?       @map("deletion_scheduled_for")
  termsVersion        String           @map("terms_version") @db.VarChar(16)
  termsAcceptedAt     DateTime         @map("terms_accepted_at")
  /// First-touch UTM values, captured only with analytics consent. Shape: { utm_source, utm_medium, ... }.
  acquisition         Json?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  athleteProfile   AthleteProfile?
  guardianConsent  GuardianConsent?
  subscriptions    Subscription[]
  checkoutSessions CheckoutSession[]
  aiUsage          AiUsage[]
  testimonials     Testimonial[]

  @@index([role])
  @@index([deletionScheduledFor])
  @@map("users")
}

model GuardianConsent {
  id            String                @id @default(uuid(7)) @db.Uuid
  userId        String                @unique @map("user_id") @db.Uuid
  guardianEmail String                @map("guardian_email") @db.VarChar(254)
  /// SHA-256 of the emailed token. The raw token is never stored.
  tokenHash     String                @unique @map("token_hash") @db.Char(64)
  status        GuardianConsentStatus @default(PENDING)
  expiresAt     DateTime              @map("expires_at")
  grantedAt     DateTime?             @map("granted_at")
  revokedAt     DateTime?             @map("revoked_at")
  /// SHA-256 of the guardian's long-lived management link token (withdraw consent, request deletion).
  manageTokenHash      String?        @unique @map("manage_token_hash") @db.Char(64)
  manageTokenExpiresAt DateTime?      @map("manage_token_expires_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("guardian_consents")
}

// ---------------------------------------------------------------------------
// Athletes and metrics
// ---------------------------------------------------------------------------

model AthleteProfile {
  userId          String    @id @map("user_id") @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(50)
  lastName        String    @map("last_name") @db.VarChar(50)
  gradYear        Int       @map("grad_year") @db.SmallInt
  sport           Sport     @default(BASEBALL)
  primaryPosition Position  @map("primary_position")
  /// Inches.
  heightInches    Int?      @map("height") @db.SmallInt
  /// Pounds.
  weightLbs       Int?      @map("weight") @db.SmallInt
  gpa             Decimal?  @db.Decimal(3, 2)
  highSchool      String?   @map("high_school") @db.VarChar(120)
  /// Stored without the leading @.
  twitterHandle   String?   @map("twitter_handle") @db.VarChar(15)
  bats            Handedness?
  throws          Handedness?
  publicSlug      String?   @unique @map("public_slug") @db.VarChar(64)
  /// Profiles are private by default. Minors need guardian consent before going public.
  isPublic        Boolean   @default(false) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics       Metric[]
  pipeline      RecruitingPipeline[]
  videoAnalyses VideoAnalysis[]

  @@index([sport, gradYear, primaryPosition])
  @@map("athlete_profiles")
}

model Metric {
  id         String     @id @default(uuid(7)) @db.Uuid
  athleteId  String     @map("athlete_id") @db.Uuid
  /// Date the measurement was taken (not the date it was logged).
  date       DateTime   @db.Date
  metricType MetricType @map("metric_type")
  value      Decimal    @db.Decimal(7, 2)
  verified   Boolean    @default(false)
  /// Private storage object key of the supporting video. Resolved to a short-lived signed URL on read.
  videoUrl   String?    @map("video_url") @db.VarChar(512)
  createdAt  DateTime   @default(now()) @map("created_at")

  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)

  // Profile pages and progression charts: latest values per type.
  @@index([athleteId, metricType, date(sort: Desc)])
  // Free tier monthly logging quota.
  @@index([athleteId, createdAt])
  // Weekly percentile aggregation.
  @@index([metricType, date])
  @@map("metrics")
}

// ---------------------------------------------------------------------------
// Colleges and recruiting
// ---------------------------------------------------------------------------

model CollegeProgram {
  id                       String    @id @default(uuid(7)) @db.Uuid
  schoolName               String    @map("school_name") @db.VarChar(160)
  sport                    Sport     @default(BASEBALL)
  division                 Division
  conference               String?   @db.VarChar(120)
  /// Two-letter US state or territory code.
  state                    String?   @db.Char(2)
  /// Shape validated by src/lib/matchmaker/program-metrics.ts:
  /// { "<MetricType>": { "mean": number, "sd": number } }
  averageRecruitingMetrics Json      @map("average_recruiting_metrics")
  minGpa                   Decimal?  @map("min_gpa") @db.Decimal(3, 2)
  headCoachName            String?   @map("head_coach_name") @db.VarChar(120)
  headCoachEmail           String?   @map("head_coach_email") @db.VarChar(254)
  headCoachSince           DateTime? @map("head_coach_since") @db.Date
  /// Where the program data came from, so every number shown to users is traceable.
  dataSourceUrl            String?   @map("data_source_url") @db.VarChar(512)
  dataVerifiedAt           DateTime? @map("data_verified_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  pipeline RecruitingPipeline[]

  @@unique([schoolName, sport])
  @@index([sport, division])
  @@map("college_programs")
}

model RecruitingPipeline {
  id              String         @id @default(uuid(7)) @db.Uuid
  athleteId       String         @map("athlete_id") @db.Uuid
  collegeId       String         @map("college_id") @db.Uuid
  status          PipelineStatus @default(INTERESTED)
  lastContactDate DateTime?      @map("last_contact_date") @db.Date
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)
  college CollegeProgram @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([athleteId, collegeId])
  @@index([athleteId, status])
  @@index([collegeId])
  @@map("recruiting_pipeline")
}

// ---------------------------------------------------------------------------
// Billing (Stripe is the source of truth; these tables are a synchronized mirror)
// ---------------------------------------------------------------------------

model Subscription {
  /// Stripe subscription id (sub_...).
  id                String             @id @db.VarChar(64)
  userId            String             @map("user_id") @db.Uuid
  status            SubscriptionStatus
  priceId           String             @map("price_id") @db.VarChar(64)
  interval          BillingInterval
  currentPeriodEnd  DateTime?          @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A partial unique index in the migration guarantees at most one live subscription per user.
  @@index([userId, status])
  @@map("subscriptions")
}

model CheckoutSession {
  /// Stripe Checkout Session id (cs_...).
  id        String                @id @db.VarChar(255)
  userId    String                @map("user_id") @db.Uuid
  priceId   String                @map("price_id") @db.VarChar(64)
  url       String                @db.VarChar(2048)
  status    CheckoutSessionStatus @default(OPEN)
  expiresAt DateTime              @map("expires_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@map("checkout_sessions")
}

/// Webhook idempotency ledger. A Stripe event id is processed at most once.
model StripeEvent {
  id          String   @id @db.VarChar(255)
  type        String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("stripe_events")
}

// ---------------------------------------------------------------------------
// AI biomechanics
// ---------------------------------------------------------------------------

model VideoAnalysis {
  id           String              @id @default(uuid(7)) @db.Uuid
  athleteId    String              @map("athlete_id") @db.Uuid
  motionType   MotionType          @map("motion_type")
  handedness   Handedness
  status       VideoAnalysisStatus @default(AWAITING_UPLOAD)
  /// Private object key in the uploads bucket.
  objectKey    String              @unique @map("object_key") @db.VarChar(512)
  contentType  String              @map("content_type") @db.VarChar(64)
  sizeBytes    Int                 @map("size_bytes")
  durationMs   Int?                @map("duration_ms")
  /// Pixel dimensions reported at upload, used to compute true-proportion distances from normalized keypoints.
  widthPx      Int?                @map("width_px")
  heightPx     Int?                @map("height_px")
  /// Compact pose track used by the skeleton overlay. Loaded only on the detail view.
  poseData     Json?               @map("pose_data")
  /// Kinematic sequence report (see src/lib/biomechanics/types.ts).
  report       Json?
  algorithm    String?             @db.VarChar(32)
  errorCode    String?             @map("error_code") @db.VarChar(64)
  createdAt    DateTime            @default(now()) @map("created_at")
  startedAt    DateTime?           @map("started_at")
  completedAt  DateTime?           @map("completed_at")

  athlete AthleteProfile @relation(fields: [athleteId], references: [userId], onDelete: Cascade)

  @@index([athleteId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("video_analyses")
}

// ---------------------------------------------------------------------------
// Autonomous agents
// ---------------------------------------------------------------------------

/// Weekly percentile baselines computed by the Data and SEO agent from anonymized aggregates.
/// Cohorts below the k-anonymity threshold are never stored.
model PercentileBaseline {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Monday of the ISO week the snapshot covers.
  computedFor DateTime   @map("computed_for") @db.Date
  /// "<METRIC>|<GRAD_YEAR or *>|<POSITION or *>". Keeps the unique key NULL-free.
  cohortKey   String     @map("cohort_key") @db.VarChar(64)
  metricType  MetricType @map("metric_type")
  gradYear    Int?       @map("grad_year") @db.SmallInt
  position    Position?
  sampleSize  Int        @map("sample_size")
  p10         Decimal    @db.Decimal(7, 2)
  p25         Decimal    @db.Decimal(7, 2)
  p50         Decimal    @db.Decimal(7, 2)
  p75         Decimal    @db.Decimal(7, 2)
  p90         Decimal    @db.Decimal(7, 2)
  mean        Decimal    @db.Decimal(7, 2)
  stddev      Decimal    @db.Decimal(7, 2)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@unique([computedFor, cohortKey])
  @@index([metricType, gradYear, position, computedFor(sort: Desc)])
  @@map("percentile_baselines")
}

model BlogPost {
  id               String        @id @default(uuid(7)) @db.Uuid
  slug             String        @unique @db.VarChar(120)
  title            String        @db.VarChar(120)
  metaDescription  String        @map("meta_description") @db.VarChar(160)
  /// Markdown. Rendered without raw HTML support, so it cannot carry script.
  bodyMarkdown     String        @map("body_markdown") @db.Text
  status           ContentStatus @default(DRAFT)
  /// The exact aggregate numbers the post was written from.
  dataSnapshot     Json          @map("data_snapshot")
  validationReport Json?         @map("validation_report")
  /// Model identifier when AI-assisted. Shown to readers as a disclosure.
  generatedBy      String?       @map("generated_by") @db.VarChar(64)
  kind             ContentKind   @default(DATA_REPORT)
  /// Case studies only: when the featured athlete (and guardian, for minors) gave written consent to publish.
  consentRecordedAt DateTime?    @map("consent_recorded_at")
  agentRunId       String?       @map("agent_run_id") @db.Uuid
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)])
  @@index([kind, status, publishedAt(sort: Desc)])
  @@map("blog_posts")
}

model MarketingAsset {
  id               String               @id @default(uuid(7)) @db.Uuid
  agentRunId       String               @map("agent_run_id") @db.Uuid
  channel          MarketingChannel
  status           MarketingAssetStatus @default(DRAFT)
  topic            String               @db.VarChar(200)
  /// Ready-to-publish payload for the channel.
  payload          Json
  /// Findings from the claims and policy checker. Empty array means clean.
  complianceIssues Json                 @map("compliance_issues")
  externalId       String?              @map("external_id") @db.VarChar(128)
  publishedAt      DateTime?            @map("published_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([agentRunId])
  @@map("marketing_assets")
}

model AgentRun {
  id         String         @id @default(uuid(7)) @db.Uuid
  agent      AgentType
  /// Schedule slot, e.g. "2026-10-06T10:00". Unique per agent so overlapping schedulers cannot double-run.
  slot       String         @db.VarChar(32)
  status     AgentRunStatus @default(RUNNING)
  stats      Json?
  error      String?        @db.Text
  startedAt  DateTime       @default(now()) @map("started_at")
  finishedAt DateTime?      @map("finished_at")

  marketingAssets MarketingAsset[]
  blogPosts       BlogPost[]

  @@unique([agent, slot])
  @@index([agent, startedAt(sort: Desc)])
  @@map("agent_runs")
}

/// Cost ledger for every paid AI call. Enforces per-user and global monthly spending caps.
model AiUsage {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  feature      AiFeature
  model        String    @db.VarChar(64)
  inputTokens  Int       @default(0) @map("input_tokens")
  outputTokens Int       @default(0) @map("output_tokens")
  /// Estimated cost in millionths of a US dollar.
  costMicros   Int       @map("cost_micros")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

/// Security-relevant events. Holds ids, never secrets or raw IP addresses.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(64)
  targetId   String?  @map("target_id") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Marketing site
// ---------------------------------------------------------------------------

/// Reviews from real users only. Published only with recorded consent; admins cannot invent an author.
model Testimonial {
  id                String        @id @default(uuid(7)) @db.Uuid
  /// The KineticScout account that gave the review. Deleting the account deletes the review.
  userId            String        @map("user_id") @db.Uuid
  displayName       String        @map("display_name") @db.VarChar(80)
  /// e.g. "Parent of a 2027 shortstop", written or approved by the author.
  descriptor        String        @db.VarChar(120)
  quote             String        @db.VarChar(600)
  rating            Int?          @db.SmallInt
  status            ContentStatus @default(DRAFT)
  consentRecordedAt DateTime      @map("consent_recorded_at")
  publishedAt       DateTime?     @map("published_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt(sort: Desc)])
  @@map("testimonials")
}

/// Contact form submissions. Purged after 12 months by the worker sweep.
model ContactMessage {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @db.VarChar(100)
  email      String    @db.VarChar(254)
  topic      String    @db.VarChar(32)
  message    String    @db.VarChar(4000)
  repliedAt  DateTime? @map("replied_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

/// Proof that a deletion request was received and completed. Holds no personal data: the subject is
/// a keyed hash of the deleted user id, so a later inquiry can be answered without keeping the account.
model DataDeletionReceipt {
  id           String            @id @default(uuid(7)) @db.Uuid
  subjectHash  String            @map("subject_hash") @db.Char(64)
  requestedBy  DeletionRequester @map("requested_by")
  requestedAt  DateTime          @map("requested_at")
  scheduledFor DateTime          @map("scheduled_for")
  canceledAt   DateTime?         @map("canceled_at")
  completedAt  DateTime?         @map("completed_at")
  /// Steps finished so far (stripe, storage, auth, database). Makes retries resume, not repeat.
  steps        Json              @default("[]")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([subjectHash])
  @@index([completedAt, scheduledFor])
  @@map("data_deletion_receipts")
}
