PORT=4000
NODE_ENV=development

# Postgres — /backend is the only service with a direct DB connection.
# The /agents service reaches this data only through the /api/agents/*
# routes below, authenticated with AGENTS_SERVICE_TOKEN.
DATABASE_URL=postgres://autonoma_backend:changeme@localhost:5432/autonoma

# Allowed origin for the frontend (comma-separated for multiple environments)
FRONTEND_ORIGIN=http://localhost:3000

# --- Payments ---
# 'mock' (default): no Stripe account needed. Checkout endpoints complete
# the same DB write a real Stripe webhook would eventually trigger,
# synchronously, and redirect straight to the success page — the whole
# waitlist -> deposit -> kickoff funnel is clickable in a demo today.
# Switch to 'live' once real Stripe keys/prices exist (see README
# "Going live with Stripe"); the 6 STRIPE_* vars below become required
# at startup the moment you do.
PAYMENTS_MODE=mock

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — one-time deposit + three recurring subscription tiers
STRIPE_PRICE_DEPOSIT=price_xxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_CORE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SCALE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxx

CHECKOUT_SUCCESS_URL=http://localhost:3000/waitlist/success
CHECKOUT_CANCEL_URL=http://localhost:3000/waitlist

# --- Auth ---
# Shared secret the /agents service presents to write agent_runs/heartbeats
# and read unscored leads. Rotate independently of founder dashboard auth.
AGENTS_SERVICE_TOKEN=changeme-shared-secret-between-agents-and-backend

# Simple bearer token gating the founder dashboard API. Swap for real auth
# (e.g. Clerk/Auth0/session cookies) before this goes further than one founder.
DASHBOARD_TOKEN=changeme-founder-dashboard-token

# --- Vapi (voice AI) ---
# Optional: without VAPI_PRIVATE_API_KEY set, cold-call triggers run in
# mock mode (logged, never dialed) — see src/lib/vapi.ts. This key is
# your PRIVATE Vapi key (server-side only, never exposed to the browser).
VAPI_PRIVATE_API_KEY=

# Hard allowlist — lib/vapi.ts refuses to touch any assistant ID other
# than these two, no matter what's passed in. Defaults are the IDs given
# at setup; double check in your Vapi dashboard that these are actually
# assigned to "Autonoma Cold Call" and "Autonoma Website Demo" respectively.
VAPI_ASSISTANT_ID_COLD_CALL=477be865-42ea-4b34-bc1c-3e7072ab2b5c
VAPI_ASSISTANT_ID_WEBSITE_DEMO=7b531751-6325-4faf-8c38-03b1186a7ed8

# The outbound call API needs a Vapi phoneNumberId (a UUID Vapi assigns
# once you import/buy a number in their dashboard) — set this once you
# have one. FOUNDER_PHONE_NUMBER is kept separately since the number
# given at setup was a raw 10-digit number, not a Vapi resource id.
VAPI_PHONE_NUMBER_ID=
FOUNDER_PHONE_NUMBER=4694006197

# --- Email notifications ---
# Optional: without RESEND_API_KEY, signup notifications are logged
# instead of emailed. Get a key at https://resend.com (free tier is
# plenty for this volume).
RESEND_API_KEY=
FOUNDER_NOTIFICATION_EMAIL=rohanadams352@gmail.com

# --- Gmail (inbox management) ---
# Optional: without these, inbox sync/send run in mock mode — see
# src/lib/gmail.ts. All four are required together once you turn this on.
# Create an OAuth2 client at https://console.cloud.google.com (Gmail API
# enabled), grant it the gmail.modify scope, and generate a refresh token
# for the inbox you want the agent reading/sending from.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# --- Google Calendar ---
# Optional: without these, calendar proposals compute canned future
# weekday slots instead of checking real availability, and there's no
# founder-facing booking endpoint until they're set — see
# src/lib/calendar.ts. Same Google Cloud OAuth2 client as Gmail above
# works here too (add the calendar scope), or use a separate client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Twilio (SMS) ---
# Optional: without these, SMS sends are logged instead of dispatched,
# and the inbound webhook rejects everything (nothing to verify the
# signature against) — see src/lib/sms.ts. Get a number at
# https://twilio.com and set its SMS webhook to
# POST {your backend URL}/api/webhooks/twilio/sms.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
