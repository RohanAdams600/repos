# Base URL of the /backend service, called from the waitlist form and
# dashboard for waitlist submissions, Stripe checkout session creation,
# and (server-side only) the dashboard overview API.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Founder dashboard bearer token. Entered client-side on /dashboard's
# login screen and kept only in memory/sessionStorage — never checked
# into source. Must match DASHBOARD_TOKEN in backend/.env.
NEXT_PUBLIC_DASHBOARD_AUTH_HINT=ask the founder for the current token
